{
  "name": "review-queue-status-list",
  "intent": "List the pull requests in my review queue with their current state so I can multi-select which ones to batch-review.",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "review-queue-status-list",
        "catalogId": "https://github.com/retz8/a2ui-github/blob/main/primer-a2ui-adapter/catalogs/v0.9.1/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "review-queue-status-list",
        "components": [
          {
            "id": "root",
            "component": "Stack",
            "direction": "vertical",
            "gap": "normal",
            "children": ["heading", "list", "footer"]
          },
          {
            "id": "heading",
            "component": "Heading",
            "text": "Your review queue",
            "as": "h2",
            "variant": "medium"
          },
          {
            "id": "list",
            "component": "ActionList",
            "role": "listbox",
            "selectionVariant": "multiple",
            "showDividers": true,
            "children": ["row-0", "row-1", "row-2", "row-3"]
          },
          {
            "id": "row-0",
            "component": "ActionList.Item",
            "selected": {
              "path": "/prs/0/selected"
            },
            "children": ["row-0-lv", "row-0-title", "row-0-desc"]
          },
          {
            "id": "row-0-lv",
            "component": "ActionList.LeadingVisual",
            "children": ["row-0-icon"]
          },
          {
            "id": "row-0-icon",
            "component": "Icon",
            "name": "git-pull-request",
            "fill": "open",
            "accessibility": {
              "label": "Open pull request"
            }
          },
          {
            "id": "row-0-title",
            "component": "Text",
            "text": {
              "path": "/prs/0/title"
            },
            "weight": "semibold"
          },
          {
            "id": "row-0-desc",
            "component": "ActionList.Description",
            "text": {
              "path": "/prs/0/meta"
            },
            "variant": "block"
          },
          {
            "id": "row-1",
            "component": "ActionList.Item",
            "selected": {
              "path": "/prs/1/selected"
            },
            "children": ["row-1-lv", "row-1-title", "row-1-desc"]
          },
          {
            "id": "row-1-lv",
            "component": "ActionList.LeadingVisual",
            "children": ["row-1-icon"]
          },
          {
            "id": "row-1-icon",
            "component": "Icon",
            "name": "git-pull-request-draft",
            "fill": "muted",
            "accessibility": {
              "label": "Draft pull request"
            }
          },
          {
            "id": "row-1-title",
            "component": "Text",
            "text": {
              "path": "/prs/1/title"
            },
            "weight": "semibold"
          },
          {
            "id": "row-1-desc",
            "component": "ActionList.Description",
            "text": {
              "path": "/prs/1/meta"
            },
            "variant": "block"
          },
          {
            "id": "row-2",
            "component": "ActionList.Item",
            "selected": {
              "path": "/prs/2/selected"
            },
            "children": ["row-2-lv", "row-2-title", "row-2-desc"]
          },
          {
            "id": "row-2-lv",
            "component": "ActionList.LeadingVisual",
            "children": ["row-2-icon"]
          },
          {
            "id": "row-2-icon",
            "component": "Icon",
            "name": "git-merge",
            "fill": "done",
            "accessibility": {
              "label": "Merged pull request"
            }
          },
          {
            "id": "row-2-title",
            "component": "Text",
            "text": {
              "path": "/prs/2/title"
            },
            "weight": "semibold"
          },
          {
            "id": "row-2-desc",
            "component": "ActionList.Description",
            "text": {
              "path": "/prs/2/meta"
            },
            "variant": "block"
          },
          {
            "id": "row-3",
            "component": "ActionList.Item",
            "selected": {
              "path": "/prs/3/selected"
            },
            "children": ["row-3-lv", "row-3-title", "row-3-desc"]
          },
          {
            "id": "row-3-lv",
            "component": "ActionList.LeadingVisual",
            "children": ["row-3-icon"]
          },
          {
            "id": "row-3-icon",
            "component": "Icon",
            "name": "git-pull-request-closed",
            "fill": "closed",
            "accessibility": {
              "label": "Closed pull request"
            }
          },
          {
            "id": "row-3-title",
            "component": "Text",
            "text": {
              "path": "/prs/3/title"
            },
            "weight": "semibold"
          },
          {
            "id": "row-3-desc",
            "component": "ActionList.Description",
            "text": {
              "path": "/prs/3/meta"
            },
            "variant": "block"
          },
          {
            "id": "footer",
            "component": "Stack",
            "direction": "horizontal",
            "gap": "condensed",
            "align": "center",
            "children": ["footer-text", "footer-count"]
          },
          {
            "id": "footer-text",
            "component": "Text",
            "text": "Selected for batch review",
            "size": "small"
          },
          {
            "id": "footer-count",
            "component": "CounterLabel",
            "count": {
              "call": "countSelected",
              "args": {
                "items": {
                  "path": "/prs"
                }
              },
              "returnType": "number"
            },
            "variant": "primary"
          }
        ]
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "review-queue-status-list",
        "path": "/",
        "value": {
          "prs": [
            {
              "title": "Add incremental heal to stream parser",
              "meta": "Open · primer-a2ui-adapter · awaiting your review",
              "selected": false
            },
            {
              "title": "Spike: allowed_components pruning",
              "meta": "Draft · agent · not ready",
              "selected": false
            },
            {
              "title": "Ship StateLabel status enum",
              "meta": "Merged · primer-a2ui-adapter · follow-up review",
              "selected": false
            },
            {
              "title": "Revert experimental cache layer",
              "meta": "Closed · agent · closed without merge",
              "selected": false
            }
          ]
        }
      }
    }
  ]
}
