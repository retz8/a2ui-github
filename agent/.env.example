# Live agent (llm_agent) configuration. Copy to agent/.env and fill in.

# Gemini model (ADK-native) — the model the demo runs on, per task 7.7 decision 9.
# When a defect looks like a model ceiling rather than a prompt problem, swap up
# through this same knob to gemini-3.1-pro-preview, the ladder's remaining rung.
#
# Do not drop to gemini-3.5-flash-lite. It is below this task's floor on two
# independent observations: beat 1 produced no surface at all on it, both attempts
# dying on the same malformed bracket, and beat 6 on lite made a single tool call,
# fetched neither README nor file tree, emitted zero affordances, and invented the
# repository description outright.
MODEL_NAME=gemini-3.5-flash

# Google AI Studio API key — ADK reads this to auth Gemini.
GOOGLE_API_KEY=your-google-ai-studio-key

# Use the AI Studio (API-key) backend rather than Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Fine-grained GitHub PAT for the remote GitHub MCP server. Create it under your
# personal account's developer settings with read-only access to public
# repositories, and grant no write permission — read-only is enforced both here
# and by the server's read-only endpoint. Note this token mode reaches every
# public repository but none of your own private ones.
GITHUB_MCP_PAT=your-fine-grained-read-only-pat

# Tool backend: "mcp" (live GitHub, the default) or "stub" (canned fixture data,
# no GitHub calls). The active backend is named in the startup log.
TOOL_BACKEND=mcp
